# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Public URL of this site. Used for join links and QR codes players scan, so it
# must be reachable from phones (e.g. https://bringme.example.com). Never an
# internal/localhost URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit, never log.
# Supabase > Project Settings > API Keys > secret key (or legacy service_role key).
# Used only by lib/supabase/admin.ts (guest join/submissions, admin actions).
SUPABASE_SECRET_KEY=your-secret-key

# SERVER ONLY. Lets the server mint short-lived tokens so guest players (no Supabase
# account) can LISTEN to their own game's private Realtime channel. Supabase >
# Project Settings > API > JWT Secret (legacy HS256). Optional: without it the
# game still works, players just get slower "basic mode" updates (4 s polling).
SUPABASE_JWT_SECRET=your-jwt-secret

# ---- Polar (Game Pass checkout) — see POLAR_PRODUCT_SETUP.md. SERVER ONLY: never NEXT_PUBLIC_.
# Use DIFFERENT values per deployment: sandbox ids/tokens for local + preview, production ones
# only in the production deployment. Checkout stays off unless all of these are valid.
BILLING_CHECKOUT_ENABLED=false
# sandbox | production (no default). "production" is refused outside a production runtime,
# "sandbox" is refused inside one.
POLAR_SERVER=sandbox
# Organization access token for THAT Polar environment (Settings > Developers > New token).
POLAR_ACCESS_TOKEN=
# Webhook signing secret for THAT environment (used by the webhook handler, next phase).
POLAR_WEBHOOK_SECRET=
# Polar organization id (UUID) in THAT environment; orders of any other organization are refused.
POLAR_ORGANIZATION_ID=
# Production only: set to true AFTER the sandbox checklist (POLAR_PRODUCT_SETUP.md §9) passed.
BILLING_PRODUCTION_APPROVED=false
# Non-Vercel staging server running `next start`: set to "staging" so sandbox Polar is allowed.
# BILLING_RUNTIME=staging
# One-time product ids (UUID) in THAT environment. A plan without an id is not offered.
POLAR_PRODUCT_ID_STARTER=
POLAR_PRODUCT_ID_PARTY=
POLAR_PRODUCT_ID_PRO=

# Digits in the emailed sign-in code. Must match Supabase → Auth → Providers → Email → "Email OTP Length" (6–10, default 6).
NEXT_PUBLIC_AUTH_OTP_LENGTH=6
